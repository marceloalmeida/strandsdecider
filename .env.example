# strandsdecider Docker environment variables
# Copy this file to .env and customize as needed

# Hugging Face model checkpoint to serve
# Default: StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
# Other options: StrandsAgents/strands-decider-E4B-gemma4-v1-2610
MODEL_ID=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610

# Extra CLI flags for the strands-decider serve command
# Examples:
#   --vision                    # Enable vision input (requires vision build)
#   --ipex-optimize             # Enable IPEX optimizations (requires ipex build)
#   --ipex-quantize=int8_dynamic # Enable INT8 dynamic quantization (requires ipex-quant build)
#   --port 8000 --host 0.0.0.0  # Server binding (default)
STRANDS_ARGS=--port 8000 --host 0.0.0.0

# Optional: Hugging Face token for higher rate limits and private models
# HF_TOKEN=your_token_here